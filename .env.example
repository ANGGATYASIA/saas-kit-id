# saas-kit-id environment variables.
# Copy this file to `.env` (or `.env.local`) and fill in the blanks.
# Anything marked REQUIRED must be set before the app can run.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Public URL of your deployment. Used for auth callbacks and email links.
# Local development: http://localhost:3000
# Production: https://yourdomain.com
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------

# Postgres connection string. Any Postgres works: Neon, Supabase (database
# only), a VPS, or local Docker.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example local Docker: postgresql://postgres:postgres@localhost:5432/saas_kit_id
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth — Better Auth (REQUIRED)
# ---------------------------------------------------------------------------

# Secret used to sign sessions. Generate one with:
#   openssl rand -base64 32
# Never reuse the same secret across environments.
BETTER_AUTH_SECRET=

# Base URL Better Auth uses for callbacks. Matches APP_URL in most setups.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth credentials. Get them at:
#   Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# Redirect URI to register: ${BETTER_AUTH_URL}/api/auth/callback/google
# (i.e. http://localhost:3000/api/auth/callback/google for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Payments — Midtrans (REQUIRED for checkout)
# ---------------------------------------------------------------------------

# Sandbox keys: https://dashboard.sandbox.midtrans.com → Settings → Access Keys
# Production keys: https://dashboard.midtrans.com (only after going live)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# false = sandbox (test payments, no real money). true = production.
MIDTRANS_IS_PRODUCTION=false

# ---------------------------------------------------------------------------
# Payments — Xendit (REQUIRED for Xendit checkout)
# ---------------------------------------------------------------------------

# Secret key: https://dashboard.xendit.co/settings/developers#api-keys
# (sandbox keys live under the "Test mode" toggle in the dashboard)
XENDIT_SECRET_KEY=

# Verification token for incoming webhooks:
#   Xendit Dashboard → Settings → Developers → Webhooks → Callback verification token
# The app rejects any webhook whose x-callback-token header does not match this.
XENDIT_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Email — Resend (REQUIRED for auth + payment emails)
# ---------------------------------------------------------------------------

# API key: https://resend.com → API Keys → Create API Key
RESEND_API_KEY=

# The address emails are sent from. Must use a domain you verified in Resend
# (https://resend.com/domains). Format: "Name <noreply@yourdomain.com>"
EMAIL_FROM="saas-kit-id <noreply@example.com>"

# ---------------------------------------------------------------------------
# Analytics — PostHog (optional; safe to leave empty)
# ---------------------------------------------------------------------------

# Project API key: https://app.posthog.com → Project settings → Project API key
NEXT_PUBLIC_POSTHOG_KEY=

# Usually https://app.posthog.com (EU: https://eu.posthog.com).
# Leave the default unless you self-host PostHog.
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---------------------------------------------------------------------------
# Error tracking — Sentry (optional; safe to leave empty)
# ---------------------------------------------------------------------------

# DSN: https://sentry.io → your project → Settings → Client Keys (DSN)
SENTRY_DSN=

# Sentry org/project slugs, only needed if you want source maps uploaded.
# Find them at https://sentry.io → Settings → your organization/project.
# Leave empty to skip the upload — error tracking still works via SENTRY_DSN.
SENTRY_ORG=
SENTRY_PROJECT=

# ---------------------------------------------------------------------------
# Cron — expiry reminders (optional; safe to leave empty)
# ---------------------------------------------------------------------------

# Shared secret the reminder cron expects as the `x-cron-secret` header.
# Generate one with:
#   openssl rand -hex 32
# Schedule GET /api/cron/reminders once a day — Vercel Cron or any external
# scheduler — with that header set.
CRON_SECRET=
